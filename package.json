{
  "name": "iss-cloud-sync",
  "productName": "ISS Cloud Sync",
  "version": "1.0.0",
  "description": "Reads the weighbridge shared folder and uploads tickets to ISS Remote Monitor. Read-only — never modifies the share.",
  "author": { "name": "Industrial Scale Solutions", "email": "jppretorius99.jp@gmail.com" },
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "za.co.iss.cloud-sync",
    "productName": "ISS Cloud Sync",
    "copyright": "© 2026 Industrial Scale Solutions",
    "files": ["electron/**/*", "renderer/**/*", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
